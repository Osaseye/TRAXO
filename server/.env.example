# ── Server Runtime & CORS ────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
EXECUTION_MODE=paper
# Comma-separated list of allowed frontend origins (e.g. https://traxo.vercel.app)
ALLOWED_ORIGINS=http://localhost:5173

# Optional persistent disk path for embedded SQLite (defaults to server/data/traxo_market.db)
# TRAXO_SQLITE_PATH=/var/data/traxo_market.db

# ── Market Data (TwelveData 4-Key Rotation + Finnhub 2-Key Rotation) ─────────
TWELVEDATA_API_KEY=
TWELVEDATA_API_KEY_2=
TWELVEDATA_API_KEY_3=
TWELVEDATA_API_KEY_4=

FINNHUB_API_KEY=
FINNHUB_API_KEY_2=

# ── Primary Upstash Redis (South Africa — loyal-lamb) ────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_URL=

# ── Backup / Offload Upstash Redis (US-Central — active-mustang) ─────────────
UPSTASH_BACKUP_REDIS_REST_URL=
UPSTASH_BACKUP_REDIS_REST_TOKEN=
UPSTASH_BACKUP_REDIS_URL=

# ── Firebase Admin SDK ───────────────────────────────────────────────────────
# Single-line JSON string of your Firebase Service Account key
FIREBASE_SERVICE_ACCOUNT=

# ── Optional Live Broker Bridge (MetaApi / Exness MT5) ───────────────────────
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
