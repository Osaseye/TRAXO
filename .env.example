# ── Backend API & WebSocket Base URL (Option B Split Hosting) ─────────────────
# Set this to your live Render backend URL (no trailing slash), e.g.:
# VITE_API_URL=https://traxo-server.onrender.com
VITE_API_URL=http://localhost:8080
VITE_SERVER_URL=http://localhost:8080

# ── Firebase (Frontend Auth & Firestore) ─────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Admin Portal ─────────────────────────────────────────────────────────────
# Comma-separated list of email addresses that can access /admin
VITE_ADMIN_EMAILS=you@example.com
