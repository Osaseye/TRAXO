# ── Firebase (frontend) ──────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Market data ───────────────────────────────────────────────────────────────
# Up to 4 TwelveData keys are supported — requests are round-robined across
# all keys that are defined, reducing per-key usage.
VITE_TWELVEDATA_API_KEY=
VITE_TWELVEDATA_API_KEY_2=
VITE_TWELVEDATA_API_KEY_3=
VITE_TWELVEDATA_API_KEY_4=
VITE_FINNHUB_API_KEY=

# ── News server ───────────────────────────────────────────────────────────────
# URL where server/index.js is running (default: http://localhost:8080)
VITE_SERVER_URL=http://localhost:8080

# ── Admin portal ──────────────────────────────────────────────────────────────
# Comma-separated list of email addresses that can access /admin
# The password for each address is managed through Firebase Authentication
# (use the same password you registered with, or reset it via /forgot-password)
VITE_ADMIN_EMAILS=you@example.com
