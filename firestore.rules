rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Replace the placeholder below with the admin user's UID (from the seed script output)
    function isAdminCollection(userId) {
      return userId == 'JkLqTXPjjFZA9gRrjaP1KmQl7rN2';
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isOwner(userId) || (request.auth != null && request.auth.token.admin == true);
      allow update: if isOwner(userId) || (request.auth != null && request.auth.token.admin == true);
      allow delete: if isOwner(userId) || (request.auth != null && request.auth.token.admin == true);

      match /signals/{signalId} {
        // Signals may be written by the owning user, by an authenticated admin, or
        // by unauthenticated clients only when targeting the seeded admin collection
        // (replace the placeholder above with the admin UID). This allows the
        // background scanner to save into the admin's collection when not signed in.
        allow read: if isOwner(userId) || (request.auth != null && request.auth.token.admin == true) || isAdminCollection(userId);
        allow create, update, delete: if isOwner(userId) || (request.auth != null && request.auth.token.admin == true) || isAdminCollection(userId);
      }

      match /notifications/{notificationId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    match /trades/{tradeId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
